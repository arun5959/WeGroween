# Only public configuration may use VITE_. No live services in phase 1.
# Service-role keys, payment secrets and webhook secrets belong on the server.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Fictional account UI for the Pages design preview; real access stays separate.
VITE_ACCOUNT_PREVIEW=false

# Editable fictional admin preview; does not establish staff authentication.
VITE_OPERATIONS_PREVIEW=false
