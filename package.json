{
  "name": "wegroween",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.js",
    "dev": "npm run prepare:assets && vite --host 127.0.0.1",
    "validate": "node scripts/validate-page-manifest.js",
    "build:vercel": "node scripts/build-vercel.js",
    "build": "npm run validate && npm run prepare:assets && vite build && node scripts/generate-public-pages.js",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "test:pages": "playwright test --config playwright.pages.config.js",
    "check": "npm run test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "vite": "8.3.3"
  },
  "dependencies": {
    "lenis": "1.3.26"
  }
}
